# ========== AI 大模型配置（兼容一切 OpenAI 协议接口） ==========
# 【⚠️ 重要提示】无论使用云端还是本地模型，LLM_API_KEY 都绝不能留空！
# 若使用本地模型（Ollama/LM Studio），请随便填一个单词（如 ollama 或 lm），切勿留空或保留 your_api_key_here。
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.8

# 👇 常见配置示例（使用时请注释掉上方默认配置，并取消下方对应示例的注释）：
# 
# --- 阿里云百炼 (DashScope) ---
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
#
# --- DeepSeek ---
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
#
# --- 本地 Ollama ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3.5:9b
#
# --- 本地 LM Studio ---
# LLM_API_KEY=lm-studio
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_MODEL=qwen3.5-9b

# ========== 图像生成（可选，用于朋友圈AI配图；留空则用内置占位图） ==========
# 阿里云百炼官方接口用户且余额充足，可填 qwen-image-3.0-pro；若不使用这个功能，请保持留空。
IMAGE_MODEL=

# ========== 本地图像生成（ComfyUI / SD WebUI） ==========
LOCAL_IMAGE_API_URL=http://127.0.0.1:8188
# 后端类型：comfyui 或 sdwebui
LOCAL_IMAGE_BACKEND=comfyui
# checkpoint 模型文件名（留空=自动选择第一个可用模型），例如：
# COMFYUI_CHECKPOINT=qwen-image-edit-2511
COMFYUI_CHECKPOINT=
# 生图尺寸（SD1.5 建议 512x768；SDXL 建议 832x1216 或 1024x1024）
COMFYUI_WIDTH=832
COMFYUI_HEIGHT=1216
COMFYUI_STEPS=20

# ========== 运行配置 ==========
# 服务监听的IP与端口（修改后需重启 start.bat）
HOST=127.0.0.1
PORT=8000

# 聊天上下文保留的历史对话轮数（越大越消耗 Token，建议 5-15）
HISTORY_TURNS=10

# RAG 知识库检索条数（防 OOC 增强，建议 2-5）
RAG_TOP_K=3

# 定时任务配置
MORNING_GREETING_HOUR=8
AUTO_MOMENTS=false

# ========== 聊天图片功能 ==========
# direct：将图片直接发送给多模态模型，让模型看图
# off：仅在聊天界面展示图片，不发送给模型
CHAT_IMAGE_MODE=direct

# 聊天图片最大大小，单位 MB
CHAT_IMAGE_MAX_MB=10

# 发送给模型前，图片最长边压缩尺寸
CHAT_IMAGE_MAX_SIDE=1024

# 一次聊天请求中最多携带几张历史图片
# 建议 1 或 2，过大会增加 Token 消耗
CHAT_IMAGE_HISTORY_LIMIT=2